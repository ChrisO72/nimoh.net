---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import ItemGrid from '../components/ItemGrid.astro';
import page from '../data/about.json';
---

<Layout {...page.meta}>
	<div class="space-y-16 sm:space-y-24">
		<PageIntro {...page.intro} />
		<section class="max-w-2xl">
			<h2 class="text-2xl font-semibold tracking-tight">{page.story.heading}</h2>
			<div class="mt-6 space-y-5 leading-relaxed text-neutral-600">
				{(page.story.paragraphs ?? []).map((paragraph) => <p class="whitespace-pre-line">{paragraph}</p>)}
			</div>
		</section>
		<ItemGrid {...page.values} />
	</div>
</Layout>
