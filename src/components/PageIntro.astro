---
interface Props {
	heading: string;
	description: string;
}

const { heading, description } = Astro.props;
---

<div class="max-w-2xl">
	<h1 class="text-4xl leading-tight font-semibold tracking-tight sm:text-5xl">{heading}</h1>
	<p class="mt-6 whitespace-pre-line text-lg leading-relaxed text-neutral-600">{description}</p>
	<slot />
</div>
