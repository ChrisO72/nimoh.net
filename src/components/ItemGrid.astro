---
interface Props {
	heading: string;
	items: { heading: string; description: string }[];
}

const { heading, items } = Astro.props;
---

<section class="border-t border-neutral-200 pt-10">
	<h2 class="text-2xl font-semibold tracking-tight">{heading}</h2>
	<ul class="mt-8 grid gap-8 sm:grid-cols-3">
		{(items ?? []).map((item) => (
			<li>
				<h3 class="font-medium">{item.heading}</h3>
				<p class="mt-3 whitespace-pre-line leading-relaxed text-neutral-600">{item.description}</p>
			</li>
		))}
	</ul>
</section>
