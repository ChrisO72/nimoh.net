---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" href={site.favicon} />
		<script defer src="https://analytics.nimoh.net/script.js" data-website-id="1889ceae-5971-43c2-b940-352b74790a89"></script>
		<title>{title} · {site.name}</title>
	</head>
	<body class="flex min-h-screen flex-col bg-white text-neutral-900 antialiased">
		<a href="#main" class="sr-only fixed top-4 left-4 z-10 rounded bg-white px-4 py-2 focus:not-sr-only">
			{site.labels.skipToContent}
		</a>
		<Header />
		<main id="main" tabindex="-1" class="mx-auto w-full max-w-5xl flex-1 px-6 py-16 sm:py-24">
			<slot />
		</main>
		<Footer />
	</body>
</html>
